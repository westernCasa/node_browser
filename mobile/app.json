{
  "expo": {
    "name": "NODE",
    "slug": "node-browser",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.node.browser",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "NODE connects to an AI model server you run on your own network, such as Ollama on your computer, only if you add one in Settings.",
        "NSCameraUsageDescription": "NODE uses the camera to scan the pairing code that NODE on your computer shows, so your trails can sync. Websites you visit can also ask to use the camera, for example to upload a photo; NODE asks you first.",
        "NSMicrophoneUsageDescription": "Websites you visit can ask to use the microphone, for example for a video call. NODE asks you first.",
        "NSLocationWhenInUseUsageDescription": "Websites you visit can ask for your location, for example to show nearby results. NODE asks you first."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "85F4.1",
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.node.browser",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NODE uses the camera to scan the pairing code that NODE on your computer shows, so your trails can sync. Websites you visit can also ask to use the camera, for example to upload a photo; NODE asks you first.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "backgroundColor": "#121212",
    "extra": {
      "reportEmail": "sven@western.casa"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
