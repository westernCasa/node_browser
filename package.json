{
  "name": "scout",
  "version": "0.9.7",
  "description": "Research browser that suggests the next pages to read, plays media across tabs, and keeps a research trail.",
  "main": "main.js",
  "author": "Sven Manzanarez",
  "license": "MIT",
  "scripts": {
    "start": "npx electron .",
    "dev": "npx electron .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:ios": "tauri ios dev",
    "tauri:android": "tauri android dev",
    "test:keywords": "node test/keywords-demo.js",
    "test:providers": "node test/providers-demo.js",
    "test:rules": "node test/rules-demo.js",
    "test:ai": "node test/ai-demo.js",
    "test:controller": "node test/controller-demo.js",
    "test:playback": "node test/playback-demo.js",
    "test:bookmarks": "node test/bookmarks-demo.js",
    "test:google": "node test/google-demo.js",
    "test:agents": "node test/agents-demo.js",
    "test:agent": "node test/agent-demo.js",
    "test:talk": "node test/talk-demo.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test:redteam": "node test/e2e/18-redteam.js",
    "test:unit": "node test/passwords-demo.js && node test/chat-demo.js && node test/usage-demo.js && node test/research-demo.js && node test/keywords-demo.js && node test/keywords-eval.js && node test/providers-demo.js && node test/rules-demo.js && node test/ai-demo.js && node test/controller-demo.js && node test/playback-demo.js && node test/bookmarks-demo.js && node test/google-demo.js && node test/agents-demo.js && node test/agent-demo.js && node test/talk-demo.js",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "@tauri-apps/api": "^2.8.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.19",
    "@ghostery/adblocker-electron-preload": "2.20.1",
    "electron-updater": "6.8.9"
  },
  "productName": "NODE",
  "build": {
    "appId": "app.scout.browser",
    "productName": "NODE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-overlay.js",
      "view-preload.js",
      "fs-storage.js",
      "adblock.js",
      "companion.js",
      "agents.js",
      "agent-server.js",
      "mcp-bridge.js",
      "log.js",
      "updater.js",
      "core/**",
      "renderer/**",
      "!renderer/tauri-bridge.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "NODE"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Sven Manzanarez"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "westernCasa",
        "repo": "node_browser",
        "releaseType": "release"
      }
    ],
    "artifactName": "NODE-${version}-${os}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/westernCasa/node_browser.git"
  },
  "homepage": "https://github.com/westernCasa/node_browser"
}
