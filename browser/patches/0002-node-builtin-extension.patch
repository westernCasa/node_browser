+void ComponentLoader::AddNodeExtension() {
+  // The manifest is generated by browser/extension/build.js in the NODE
+  // repository. The extension's files are copied by browser/build.sh into the
+  // framework's Resources/node_extension folder, which is where a relative
+  // root directory resolves (chrome::DIR_RESOURCES). The allowlist only knows
+  // Chromium's own component extensions, so it is skipped for this one.
+  static constexpr char kNodeExtensionManifest[] =
+#include "chrome/browser/extensions/node_extension_manifest.inc"
+      ;
+  Add(std::string_view(kNodeExtensionManifest),
+      base::FilePath(FILE_PATH_LITERAL("node_extension")),
+      /*skip_allowlist=*/true);
+}
