# The Chromium base for the NODE Chromium build. Change these together, then
# check that every patch in browser/patches still applies (see README.md).
#
# ungoogled-chromium-macos release tag: Chromium version plus ungoogled
# revision. 152 matches the Chromium inside Electron 44, so pages behave the
# same in both NODE builds while they run side by side.
UNGOOGLED_MACOS_TAG=152.0.7977.64-1.1
CHROMIUM_VERSION=152.0.7977.64
# Commit of that tag, checked after cloning so a moved tag is noticed.
UNGOOGLED_MACOS_COMMIT=4344da85fb2a3a601aa0e0ccd27107283b5a3b88
